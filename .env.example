# ---------------------------------------------------------------------------
# StreamLens - example environment. Copy to api/.env and fill in.
# NEVER commit a real .env file. Keys live only in .env.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# Which vision provider to use: "mock" (default, no key, offline) or "gemini".
AI_PROVIDER=mock

# Google Gemini. Leave empty to force the mock provider.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Hard timeout on one Gemini call, and how many times to retry after a failure.
# Only timeouts and transport errors are retried; a bad key is not.
GEMINI_TIMEOUT_S=20
GEMINI_RETRIES=1
# Which prompt in api/app/ai/prompts/ to use, without the .md.
ASSESS_PROMPT=assess_v3

# --- API -------------------------------------------------------------------
DATABASE_URL=sqlite:///./streamlens.db
UPLOAD_DIR=./uploads
# Comma-separated origins allowed to call the API (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Photo handling --------------------------------------------------------
MAX_IMAGE_PX=1600
BLUR_THRESHOLD=100.0
DARK_THRESHOLD=45.0
BRIGHT_THRESHOLD=225.0
