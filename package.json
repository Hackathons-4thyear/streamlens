{
  "name": "streamlens",
  "version": "0.1.0",
  "private": true,
  "description": "StreamLens - photo-first citizen stream assessment. IEEE OneAquaHealth Hackathon 2026.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node scripts/run-pytest.mjs",
    "test:web": "npm --prefix web run test -- --run",
    "data:sites": "python scripts/fetch_sites.py",
    "data:questions": "python scripts/build_questions.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
