# Copy to api/.env and edit. The real .env is never committed.
#
# On a hosted instance none of this is a file: every line below is set in the
# host's own environment settings instead (Render: Environment; Vercel: Project
# Settings > Environment Variables).

# --- AI provider ------------------------------------------------------------
# mock   - a labelled colour heuristic. No key needed, no photo leaves the box.
# gemini - Google Gemini, on its free tier. Requires GEMINI_API_KEY.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=20
GEMINI_RETRIES=1
ASSESS_PROMPT=assess_v3

# --- Storage ----------------------------------------------------------------
# SQLite locally; on a hosted instance paste the Postgres URL exactly as the
# provider prints it - postgres:// and postgresql:// are both understood.
DATABASE_URL=sqlite:///./streamlens.db
UPLOAD_DIR=./uploads

# --- Photographs -------------------------------------------------------------
# STORE_PHOTOS=false keeps only the quality measurements and discards the image.
# That is how the hosted demo runs, so there is nothing to show publicly and
# nothing to delete later.
STORE_PHOTOS=true
PHOTO_RETENTION_DAYS=14
MAX_IMAGE_PX=1600
# Nothing larger than this is ever sent to the AI, whatever is kept locally.
AI_MAX_IMAGE_PX=1024
MAX_UPLOAD_MB=8

# --- CORS ---------------------------------------------------------------------
# Comma-separated, exact origins. On the hosted demo this is the one Vercel
# domain and nothing else.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Protecting a free API key -------------------------------------------------
# When either limit is reached the request still succeeds, on the mock provider,
# with a visible notice. It never fails.
AI_CALLS_PER_HOUR_PER_CLIENT=10
AI_CALLS_PER_DAY_TOTAL=300
